<?xml version="1.0" encoding="UTF-8"?>
<configuration>
 <property name="log.path" value="./logs"/>
 <appender name="console" class="ch.qos.logback.core.ConsoleAppender"><encoder class="com.ruoyi.framework.audit.AuditJsonEncoder"/></appender>
 <appender name="runtime" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>logs/runtime.jsonl</file><encoder class="com.ruoyi.framework.audit.AuditJsonEncoder"/><rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"><fileNamePattern>logs/runtime.%d{yyyy-MM-dd}.%i.jsonl.gz</fileNamePattern><maxFileSize>50MB</maxFileSize><maxHistory>60</maxHistory><totalSizeCap>1GB</totalSizeCap></rollingPolicy><filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>INFO</level></filter></appender>
 <appender name="error" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>logs/sys-error.jsonl</file><encoder class="com.ruoyi.framework.audit.AuditJsonEncoder"/><rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"><fileNamePattern>logs/sys-error.%d{yyyy-MM-dd}.%i.jsonl.gz</fileNamePattern><maxFileSize>50MB</maxFileSize><maxHistory>60</maxHistory><totalSizeCap>512MB</totalSizeCap></rollingPolicy><filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>ERROR</level></filter></appender>
 <appender name="login" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>logs/login.jsonl</file><encoder class="com.ruoyi.framework.audit.AuditJsonEncoder"/><rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"><fileNamePattern>logs/login.%d{yyyy-MM-dd}.%i.jsonl.gz</fileNamePattern><maxFileSize>50MB</maxFileSize><maxHistory>60</maxHistory><totalSizeCap>512MB</totalSizeCap></rollingPolicy></appender>
 <logger name="com.ruoyi" level="INFO"/><logger name="org.springframework" level="WARN"/><logger name="sys-user" level="INFO"><appender-ref ref="login"/></logger><root level="INFO"><appender-ref ref="console"/><appender-ref ref="runtime"/><appender-ref ref="error"/></root>
</configuration>
